# ============================================
# Song Shazam Pro — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# ACRCloud (Required — https://www.acrcloud.com/)
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_KEY=your_acr_access_key
ACR_SECRET=your_acr_access_secret

# YouTube Data API v3 (Required — https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key

# Spotify Web API (Optional — https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Application
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10
